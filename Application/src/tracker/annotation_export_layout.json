{
  "defaults": {
    "vars": {
      "label_height": 37,
      "content_width": 620,
      "length":"{global.video_length}",
      "num_behavior_annotations_made": "{array_length:{global.track_frame_tags}}"
    }
  },
  "locals": {
    "tab": { "type": "int", "value": 0 },
    "tag-frame": { "type": "int", "value": 0 }
  },
  "objects": [
    {
      "type": "vlayout",
      "fill": [20, 20, 20, 220],
      "line": [230, 230, 230, 220],
      "pos": [0, 0],
      "pad":[0,0,0,10],
      "clickable": true,
      "outer_pad": [25, 20, 25, 20],
      "children": [
        {
          "type":"hlayout",
          "pad":[0,0,-1,10],
          "children": [
            {
              "type": "button",
              "text": "Detection",
              "max_size": "[{content_width}, 65]",
              "font": {"size": 0.6},
              "color": [255, 255, 255],
              "fill": "{if:{equal:{local.tab}:0}:[55,85,70,230]:[45,45,45,200]}",
              "action": "set-local:tab:0",
              "corners":["left"]
            },
            {
              "type": "button",
              "text": "Behavior",
              "max_size": "[{content_width}, 65]",
              "font": {"size": 0.6},
              "color": [255, 255, 255],
              "action": "set-local:tab:1",
              "fill": "{if:{equal:{local.tab}:1}:[55,85,70,230]:[45,45,45,200]}",
              "corners":["right"]
            }
          ]
        },
        {
          "type":"condition",
          "var":"{equal:{local.tab}:0}",
          "then": {
            "type":"vlayout",
            "outer_pad":[15,15,15,15],
            "pad":[0,0,0,10],
            "line": [100, 100, 100, 250],
            "children":[
              {
                "type": "stext",
                "text": "<h3>Export detection dataset</h3>\n<i><lightgray>Export annotated objects from the source video as a training dataset.</lightgray></i>",
                "max_size": "[{content_width}, 60]",
                "font": {"size": 0.55},
                "color": [255, 255, 255]
              },
              {
                "type": "gridlayout",
                "outer_pad":[10,10,10,10],
                "pad": [0,5,0,5],
                "fill": [30, 30, 30, 100],
                "line": [100, 100, 100, 250],
                "vertical_clr": [100, 100, 100, 100],
                "horizontal_clr": [100, 100, 100, 100],
                "cellfillclr": [0, 0, 0, 0],
                "celllineclr": [0, 0, 0, 0],
                "mincellsize": "[0, {label_height}]",
                "children": [
                  [
                    {
                      "type": "stext",
                      "text": "<gray><b>Format</b>\n<small>dataset annotation format</small></gray>",
                      "font": {"size": 0.5},
                      "pad": [10, 3, 10, 5]
                    },
                    {
                      "type": "hlayout",
                      "outer_pad": [0, 0, -1, 0],
                      "children": [
                        {
                          "type": "button",
                          "text": "{if:{equal:{info.format}:yolo}:<b>YOLO</b>:YOLO}",
                          "action": "set-format:yolo",
                          "corners": ["left"],
                          "size": "[86,{label_height}]",
                          "font": {"size": 0.5},
                          "fill": "{if:{equal:{info.format}:yolo}:[55,85,70,230]:[45,45,45,200]}",
                          "line": "{if:{equal:{info.format}:yolo}:[120,210,160,220]:[120,120,120,90]}"
                        },
                        {
                          "type": "button",
                          "text": "{if:{equal:{info.format}:coco}:<b>COCO</b>:COCO}",
                          "action": "set-format:coco",
                          "corners": ["right"],
                          "size": "[86,{label_height}]",
                          "font": {"size": 0.5},
                          "fill": "{if:{equal:{info.format}:coco}:[55,85,70,230]:[45,45,45,200]}",
                          "line": "{if:{equal:{info.format}:coco}:[120,210,160,220]:[120,120,120,90]}"
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "type": "stext",
                      "text": "<gray><b>Source video</b>\n<small>images are extracted from here</small></gray>",
                      "font": {"size": 0.5},
                      "pad": [10, 3, 10, 4]
                    },
                    {
                      "type": "hlayout",
                      "outer_pad": [0, 0, -1, 0],
                      "children": [
                        {
                          "type": "settings",
                          "var": "meta_source_path",
                          "desc": "",
                          "corners": ["left"],
                          "size": "[370,{label_height}]",
                          "font": {"size": 0.45},
                          "fill": "{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                          "line": "{if:{||:{selected}:{hovered}}:[100,175,250,200]:[100,100,100,50]}",
                          "color": [255, 255, 255]
                        },
                        {
                          "type": "button",
                          "text": "<sym>🗁</sym>",
                          "action": "choose-file:meta_source_path:{folder:{global.meta_source_path}}",
                          "corners": ["right"],
                          "size": "[40, {label_height}]",
                          "pad": [1, 0, 0, 0],
                          "font": {"align": "center", "size": 0.8, "style": "bold"},
                          "fill": "{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                          "line": "{if:{||:{selected}:{hovered}}:[100,175,250,200]:[100,100,100,50]}"
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "type": "stext",
                      "text": "<gray><b>Background %</b>\n<small>extra images without annotations</small></gray>",
                      "font": {"size": 0.5},
                      "pad": [10, 3, 10, 4]
                    },
                    {
                      "type": "textfield",
                      "text": "{info.background_percent}",
                      "action": "set-background-percent:{text}",
                      "on_text_changed": "set-background-percent:{text}",
                      "size": "[410,{label_height}]",
                      "font": {"size": 0.48},
                      "fill": [50, 50, 50, 200],
                      "line": [100, 100, 100, 50],
                      "color": [255, 255, 255],
                      "placeholder": "0"
                    }
                  ],
                  [
                    {
                      "type": "stext",
                      "text": "<gray><b>Folder suffix</b>\n<small>appended to the output folder</small></gray>",
                      "font": {"size": 0.5},
                      "pad": [10, 3, 10, 4]
                    },
                    {
                      "type": "textfield",
                      "text": "{info.suffix}",
                      "action": "set-suffix:{text}",
                      "on_text_changed": "set-suffix:{text}",
                      "size": "[410,{label_height}]",
                      "font": {"size": 0.48},
                      "fill": [50, 50, 50, 200],
                      "line": [100, 100, 100, 50],
                      "color": [255, 255, 255],
                      "placeholder": "optional"
                    }
                  ]
                ]
              },
              {
                "type": "condition",
                "var": "{info.multiple_types}",
                "then": {
                  "type": "gridlayout",
                  "pad": [8, 6, 8, 6],
                  "fill": [30, 30, 30, 100],
                  "line": [100, 100, 100, 250],
                  "vertical_clr": [100, 100, 100, 100],
                  "horizontal_clr": [100, 100, 100, 100],
                  "cellfillclr": [0, 0, 0, 0],
                  "celllineclr": [0, 0, 0, 0],
                  "mincellsize": "[0, {label_height}]",
                  "children": [
                    [
                      {
                        "type": "stext",
                        "text": "<gray><b>Include</b>\n<small>annotation types to export</small></gray>",
                        "font": {"size": 0.5},
                        "pad": [10, 3, 10, 4]
                      },
                      {
                        "type": "hlayout",
                        "outer_pad": [0, 0, -1, 0],
                        "children": [
                          {
                            "type": "button",
                            "text": "BOX ({info.boxes})",
                            "action": "toggle-type:box",
                            "corners": ["left"],
                            "size": "[110, {label_height}]",
                            "font": {"size": 0.45},
                            "fill": "{if:{info.export_boxes}:[55,85,70,230]:[45,45,45,200]}",
                            "line": "{if:{info.export_boxes}:[120,210,160,220]:[120,120,120,90]}"
                          },
                          {
                            "type": "button",
                            "text": "SEGMENTATION ({info.segmentations})",
                            "action": "toggle-type:segmentation",
                            "corners": ["none"],
                            "size": "[180, {label_height}]",
                            "font": {"size": 0.45},
                            "fill": "{if:{info.export_segmentations}:[55,85,70,230]:[45,45,45,200]}",
                            "line": "{if:{info.export_segmentations}:[120,210,160,220]:[120,120,120,90]}"
                          },
                          {
                            "type": "button",
                            "text": "POSE ({info.poses})",
                            "action": "toggle-type:pose",
                            "corners": ["right"],
                            "size": "[110, {label_height}]",
                            "font": {"size": 0.45},
                            "fill": "{if:{info.export_poses}:[55,85,70,230]:[45,45,45,200]}",
                            "line": "{if:{info.export_poses}:[120,210,160,220]:[120,120,120,90]}"
                          }
                        ]
                      }
                    ]
                  ]
                }
              },
              {
                "type": "condition",
                "var": "{info.has_annotations}",
                "then": {
                  "type": "stext",
                  "text": "{info.summary}",
                  "max_size": "[{content_width}, 150]",
                  "pad": [8, 12, 8, 8],
                  "font": {"size": 0.48},
                  "color": [235, 235, 235]
                },
                "else": {
                  "type": "stext",
                  "text": "<gray>There are no detect annotations to export yet. Draw annotations in the tracking view first (<c>track_detect_annotations</c> is empty).</gray>",
                  "max_size": "[{content_width}, 150]",
                  "pad": [8, 12, 8, 8],
                  "font": {"size": 0.48},
                  "color": [235, 235, 235]
                }
              }
            ]
          },
          "else":
          {
            "type":"condition",
            "var":"{>:{num_behavior_annotations_made}:0}",
            "then": {
              "type":"hlayout",
              "align":"top",
              "outer_pad":[15,15,15,15],
              "pad":[0,0,0,10],
              "line": [100, 100, 100, 250],
              "children":[
                {
                  "type":"vlayout",
                  "min_size":"[{*:0.5:{content_width}},200]",
                  "pad":[0,0,0,10],
                  "children":[
                    {
                      "type": "stext",
                      "text": "<h3>Export behavior dataset</h3>\n<i><lightgray>Export labeled behaviors from the source video as a training dataset.</lightgray></i>",
                      "max_size": "[{*:0.5:{content_width}}, 120]",
                      "font": {"size": 0.55},
                      "color": [255, 255, 255]
                    },
                    {
                      "type":"stext",
                      "text":"{num_behavior_annotations_made} frames were labeled",
                      "font":{"size":0.5}
                    },
                    {
                      "type":"collection",
                      "children":[
                        {
                          "type":"rect",
                          "fill":[120,230,255,100],
                          "size":"[{*:200:{/:{local.tag-frame}:{length}}},30]"
                        },
                        {
                          "type":"rect",
                          "name":"timeline-hover",
                          "clickable":true,
                          "fill":[50,200,230,0],
                          "line":[50,200,230,200],
                          "size":[200,30],
                          "drag":"set-local:tag-frame:{*:{/:{mouse_relative.x}:200}:{length}}"
                        },
                        {
                          "type":"each",
                          "var":"{global.track_frame_tags}",
                          "do":{
                            "type":"rect",
                            "clickable":true,
                            "fill":"{if:{||:{equal:{local.tag-frame}:{i}}:{hovered}}:[255,255,255,100]:[200,200,200,100]}",
                            "pos":"[{*:200:{/:{i}:{length}}},0]",
                            "size":"[5,30]",
                            "click":"set-local:tag-frame:{i}"
                          }
                        }
                      ]
                    },
                    {
                      "type":"condition",
                      "var":"{contains:{local.tag-frame}:{global.track_frame_tags}}",
                      "then":{
                        "type":"taglist",
                        "max_size":"[300, 200]",
                        "var":"{at:{local.tag-frame}:{global.track_frame_tags}}"
                      },
                      "else":{
                        "type":"stext",
                        "text":"<gray>Frame {local.tag-frame} has no tags</gray>",
                        "font":{"size":0.5}
                      }
                    }
                  ]
                },
                {
                  "type":"vlayout",
                  "pad":[0,0,0,10],
                  "children":[
                    {
                      "type":"stext",
                      "text":"<b>Clicking Export will generate two datasets</b>\n- one for any potential full-frame classification annotations,\n- and one for localized behavior annotations.\n\nThe first one is merely a collection of images + labels, while the second one is a collection of cropped individual images + their bounding boxes + labels with temporal context configured by <c>track_behavior_window</c> and <c>track_behavior_window_step</c>.",
                      "max_size":"[{*:0.5:{content_width}}, 200]",
                      "font":{"size":0.5}
                    },
                    {
                      "type":"settings",
                      "var":"track_behavior_window",
                      "desc":"",
                      "list":{ "font":{"size":0.5} },
                      "label":{
                          "corners":["all"],
                          "fill":"{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                          "line":"{if:{||:{selected}:{hovered}}:[100,175,250,230]:[100,100,100,230]}",
                          "font":{"size":0.5}
                      },
                      "pad":[0,0,-1,-1],
                      "fill":"{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                      "line":"{if:{||:{selected}:{hovered}}:[100,175,250,230]:[100,100,100,230]}",
                      "size":"[{*:0.5:{content_width}},30]"
                    },
                    {
                      "type":"settings",
                      "var":"track_behavior_window_step",
                      "desc":"",
                      "list":{ "font":{"size":0.5} },
                      "label":{
                          "corners":["all"],
                          "fill":"{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                          "line":"{if:{||:{selected}:{hovered}}:[100,175,250,230]:[100,100,100,230]}",
                          "font":{"size":0.5}
                      },
                      "pad":[0,0,-1,-1],
                      "fill":"{if:{||:{selected}:{hovered}}:[60,60,60,200]:[50,50,50,200]}",
                      "line":"{if:{||:{selected}:{hovered}}:[100,175,250,230]:[100,100,100,230]}",
                      "size":"[{*:0.5:{content_width}},30]"
                    }
                  ]
                }
              ]
            },
            "else": {
              "type":"vlayout",
              "outer_pad":[15,15,15,15],
              "pad":[0,0,0,10],
              "line": [100, 100, 100, 250],
              "children":[
                {
                  "type": "stext",
                  "text": "<h3>Export behavior dataset</h3>\n<i><lightgray>Export labeled behaviors from the source video as a training dataset.</lightgray></i>",
                  "max_size": "[{content_width}, 60]",
                  "font": {"size": 0.55},
                  "color": [255, 255, 255]
                },
                {
                  "type":"vlayout",
                  "pad":[0,0,0,10],
                  "outer_pad":[0,0,0,0],
                  "line": [100, 100, 100, 250],
                  "children":[
                    {
                      "type":"stext",
                      "text":"<gray>There are no behavior annotations to export yet. Draw annotations in the tracking view first (<c>track_frame_tags</c> is empty).</gray>",
                      "max_size": "[{*:0.75:{content_width}}, 150]",
                      "pad": [8, 12, 8, 8],
                      "font": {"size": 0.48}
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "hlayout",
          "pad": [0, 10, 0, 0],
          "children": [
            {
              "type": "button",
              "text": "Close",
              "action": "close",
              "font": {"size": 0.5, "style": "bold"},
              "fill": "{if:{||:{selected}:{hovered}}:[70,45,45,220]:[50,35,35,210]}",
              "line": "{if:{||:{selected}:{hovered}}:[230,160,150,220]:[120,100,100,90]}",
              "size": [90, 32]
            },
            {
              "type": "condition",
              "var": "{info.has_annotations}",
              "then": {
                "type": "button",
                "text": "Export",
                "action": "{if:{equals:{tab}:0}:export:export-behavior}",
                "disabled": "{not:{info.can_export}}",
                "font": {"size": 0.5, "style": "bold"},
                "fill": "{if:{||:{selected}:{hovered}}:[55,90,60,230]:[45,75,50,220]}",
                "line": "{if:{||:{selected}:{hovered}}:[120,220,150,230]:[100,120,100,100]}",
                "size": [90, 32]
              }
            }
          ]
        }
      ]
    }
  ]
}
